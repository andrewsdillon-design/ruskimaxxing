# /etc/ruskimaxxing-cloud.env  (install.sh writes this for you; chmod 600)
DATABASE_URL=postgresql+psycopg://ruskimaxxing:CHANGE_ME@localhost/ruskimaxxing
PUBLIC_URL=https://api.example.com
CONTACT_EMAIL=you@example.com

# Password-reset emails (any SMTP provider: Brevo, Mailgun, Postmark, your own server...).
# Leave SMTP_HOST empty to turn password reset off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=RuskiMaxxing <no-reply@example.com>

# Paid cloud backup ($20/year) - fill in with deploy/setup_stripe.py (see server/README.md).
# Leave STRIPE_SECRET_KEY empty and backups are free for every account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PORTAL_CONFIG=
# Accounts that always get free backups (you, family, testers), comma-separated
COMPLIMENTARY_EMAILS=
